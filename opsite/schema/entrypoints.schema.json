{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Точки входа инструмента для хаба",
  "type": "object",
  "properties": {
    "dataset": { "const": "entrypoints" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "path", "audience", "situations", "offline", "printable", "maturity", "verified", "verified_at"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^([a-z0-9-]+/)*$|^[a-z0-9-]+(/[a-z0-9-]+)*/(\\?[a-z0-9=&-]+)?$" },
          "audience": { "type": "array", "items": { "enum": ["family", "org", "lawyer", "medic", "developer"] } },
          "situations": { "type": "array", "items": { "type": "string" } },
          "offline": { "type": "boolean" },
          "printable": { "type": "boolean" },
          "maturity": { "enum": ["demo", "draft", "beta", "stable"] },
          "verified": { "type": "boolean" },
          "verified_at": { "type": ["string", "null"] }
        }
      }
    }
  }
}
