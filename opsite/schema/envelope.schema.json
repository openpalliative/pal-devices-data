{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpalliative.github.io/ui/schema/envelope.schema.json",
  "title": "Конверт датасета openpalliative",
  "type": "object",
  "required": ["format", "dataset", "repo", "schema_version", "version", "generated_at", "data_date",
               "stale_after_days", "license", "source", "content_sha256", "counts", "items"],
  "properties": {
    "format": { "const": "openpalliative-dataset/1" },
    "dataset": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "repo": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}(\\.\\d+)?$",
                 "x-message-ru": "версия в виде ГГГГ.ММ.ДД, например 2026.10.11" },
    "generated_at": { "type": "string" },
    "data_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                   "x-message-ru": "дата в виде ГГГГ-ММ-ДД" },
    "stale_after_days": { "type": "integer", "minimum": 1 },
    "license": { "type": "string", "minLength": 1 },
    "source": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "eoNumber": { "type": "string", "pattern": "^\\d{16}$" },
          "retrieved_at": { "type": "string" },
          "sha256": { "type": "string" },
          "license": { "type": "string" }
        }
      }
    },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "counts": {
      "type": "object",
      "required": ["items", "unverified", "excluded"],
      "properties": {
        "items": { "type": "integer" },
        "unverified": { "type": "integer" },
        "excluded": { "type": "integer" }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "verified", "verified_at"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "verified": { "type": "boolean", "x-message-ru": "verified должно быть true или false" },
          "verified_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "source_ref": { "type": "string" }
        }
      }
    }
  }
}
