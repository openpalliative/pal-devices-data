{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Номера «Если помощь нужна прямо сейчас»",
  "type": "object",
  "required": [
    "checked_at",
    "lines"
  ],
  "properties": {
    "checked_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "number",
          "topic",
          "label",
          "verified",
          "verified_at",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "string",
            "pattern": "^(\\d{3}|8-800-\\d{3}-\\d{2}-\\d{2})$"
          },
          "topic": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "third_party": {
            "type": "boolean"
          },
          "verified": {
            "type": "boolean"
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "eoNumber": {
                "type": "string"
              },
              "point": {
                "type": "string"
              },
              "quote_verbatim": {
                "type": "string"
              }
            }
          },
          "short": {
            "type": "string",
            "maxLength": 14
          }
        }
      }
    }
  }
}
