#!/bin/sh
set -eu
mode="${1:-facts}"
[ "$mode" = "facts" ] || { echo "Использование: scripts/watch-apply facts"; exit 2; }
if [ "${WATCH_FACTS_PUSH:-}" != "true" ]; then
  echo "Прямой пуш снимка выключен, снимок уходит через PR watch/nkmi-facts. Как включить, в docs/release.md"
  exit 0
fi
git config user.name "github-actions[bot]"
git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
git add data/snapshots raw/nkmi_subset.csv tests/golden/html
if git diff --cached --quiet; then
  echo "снимок не изменился"
  exit 0
fi
version=$(sed -n 's/.*"version": "\([0-9]*\)".*/\1/p' data/snapshots/nkmi.json | head -n 1)
git commit -m "data: снимок НКМИ ${version} $(date -u +%Y-%m-%d)"
if ! git push; then
  echo "main не принял пуш снимка: нужен обход правил для GitHub Actions или WATCH_FACTS_PUSH выключить"
  exit 1
fi
if command -v gh >/dev/null 2>&1; then
  gh workflow run pages.yml || echo "не удалось запустить pages.yml, сайт пересоберётся по расписанию"
fi
